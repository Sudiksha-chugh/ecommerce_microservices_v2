NODE_ENV=development
INVENTORY_HOST=127.0.0.1
INVENTORY_PORT=4005
INVENTORY_PGHOST=127.0.0.1
INVENTORY_PGPORT=5432
INVENTORY_PGDATABASE=inventory_db
INVENTORY_PGUSER=inventory_user
INVENTORY_PGPASSWORD=
INVENTORY_TEST_PASSWORD=
INVENTORY_PGPOOL_MAX=10
INVENTORY_PGCONNECT_TIMEOUT_MS=2000
INVENTORY_PGQUERY_TIMEOUT_MS=2000
CATALOG_SERVICE_URL=http://127.0.0.1:4001
CATALOG_REQUEST_TIMEOUT_MS=2000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
RESERVATION_TTL_SECONDS=900
EXPIRATION_WORKER_INTERVAL_MS=5000
EXPIRATION_WORKER_BATCH_SIZE=100
SHUTDOWN_TIMEOUT_MS=10000

# Optional Phase 10 bootstrap; use commerce_inventory credentials from .env.messaging.
MESSAGING_ENABLED=false
MESSAGING_DIAGNOSTIC_CONSUMERS=false
MESSAGING_URL=
MESSAGING_PREFETCH=5

# Phase 11: opt-in transactional receipts only, no checkout effects.
INBOX_ENABLED=false
