RABBITMQ_ADMIN_USER=commerce_admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_VHOST=commerce
RABBITMQ_ORDERS_PASSWORD=
RABBITMQ_INVENTORY_PASSWORD=
RABBITMQ_PAYMENTS_PASSWORD=
RABBITMQ_TEST_PASSWORD=
# Service bootstrap is opt-in. Use each service's own URL in its environment file.
MESSAGING_ENABLED=false
MESSAGING_DIAGNOSTIC_CONSUMERS=false
MESSAGING_PREFETCH=5

# Optional dedicated notification role; supply a secret before explicitly provisioning.
RABBITMQ_NOTIFICATIONS_PASSWORD=
