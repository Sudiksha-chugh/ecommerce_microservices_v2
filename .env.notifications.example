NOTIFICATION_HOST=127.0.0.1
NOTIFICATION_PORT=4007
# Distinct role/database pairs. Replace placeholders and URL-encode passwords.
DATABASE_URL=postgresql://notifications_user:replace-me@127.0.0.1:5440/notifications_db
MOCK_EMAIL_DATABASE_URL=postgresql://mock_email_user:replace-me@127.0.0.1:5440/mock_email_provider_db
RABBITMQ_URL=
NOTIFICATION_PROVIDER=mock
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_CONSUMER_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_LEASE_MS=30000
NOTIFICATION_POLL_MS=1000
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_LOOKUP_KEY=
AUTH_SERVICE_URL=http://127.0.0.1:4000
ORDERS_SERVICE_URL=http://127.0.0.1:4003
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
SAGA_ORDERS_KEY=
SAGA_PAYMENTS_KEY=
MOCK_EMAIL_SCENARIO=success
# Optional Compose profile; never launched by default infrastructure commands.
NOTIFICATIONS_DB_ADMIN_PASSWORD=
NOTIFICATIONS_DATABASE_PASSWORD=
MOCK_EMAIL_DATABASE_PASSWORD=
NOTIFICATIONS_PGPORT=5440
NOTIFICATION_DOCKER_DATABASE_URL=
MOCK_EMAIL_DOCKER_DATABASE_URL=
NOTIFICATION_DOCKER_RABBITMQ_URL=
NOTIFICATION_DOCKER_AUTH_URL=http://host.docker.internal:4000
NOTIFICATION_DOCKER_ORDERS_URL=http://host.docker.internal:4003
