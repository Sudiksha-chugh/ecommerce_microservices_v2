{
  "uid": "commerce-search-performance",
  "title": "Ecommerce search performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Search route latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/search/products\"}[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Projection/rebuild/reconciliation observations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(business_observations_total{operation=~\"search_.*\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rebuild and reconciliation duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(search_rebuild_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
