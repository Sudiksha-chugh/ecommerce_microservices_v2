{
  "uid": "commerce-sql-performance",
  "title": "Ecommerce SQL performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "All-execution operation metrics. Fingerprint reports are sampled and available only through authenticated internal reporting. Planner estimates are not execution measurements.",
  "panels": [
    {
      "id": 1,
      "title": "Executions per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,operation) (rate(sql_query_executions_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Query p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,service_name,operation) (rate(sql_query_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Query errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,operation) (rate(sql_query_errors_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Slow queries per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,operation) (rate(sql_query_slow_total[5m]))"
        }
      ]
    }
  ]
}
