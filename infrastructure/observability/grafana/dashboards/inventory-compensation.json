{
  "uid": "commerce-inventory-compensation",
  "title": "Ecommerce inventory compensation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Reservation and compensation observations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(business_observations_total{operation=~\"reservation_.*|compensation_.*\"}[5m]))"
        }
      ]
    }
  ]
}
