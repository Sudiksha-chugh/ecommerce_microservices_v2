# Opt-in only; no schema migration runs at service startup.
SEARCH_ENABLED=false
SEARCH_INDEXING_ENABLED=false
SEARCH_REBUILD_ENABLED=false
SEARCH_HOST=127.0.0.1
SEARCH_PORT=4008
SEARCH_SERVICE_URL=http://127.0.0.1:4008
SEARCH_ELASTICSEARCH_URL=http://127.0.0.1:9210
SEARCH_ELASTICSEARCH_PORT=9210
SEARCH_ELASTICSEARCH_API_KEY=
SEARCH_INDEX_ALIAS=commerce_v2_products_current
SEARCH_PGPORT=5441
SEARCH_DATABASE_URL=postgresql://search_user:unconfigured@127.0.0.1:5441/search_db
SEARCH_DOCKER_DATABASE_URL=postgresql://search_user:unconfigured@search-db:5432/search_db
SEARCH_DB_ADMIN_PASSWORD=
SEARCH_DATABASE_PASSWORD=
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_REQUEST_TIMEOUT_MS=2000
SEARCH_GATEWAY_TIMEOUT_MS=5000
SEARCH_RABBITMQ_PREFETCH=5
SEARCH_RABBITMQ_URL=
SEARCH_DOCKER_RABBITMQ_URL=
SEARCH_CATALOG_URL=http://127.0.0.1:4001
SEARCH_DOCKER_CATALOG_URL=http://host.docker.internal:4001
# Supply separate 32+ character secrets; never reuse customer tokens.
SEARCH_LOOKUP_KEY=
CATALOG_EVENT_KEY=
SEARCH_CURSOR_KEY=
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
# Configure these in Catalog's environment only after explicitly migrating its store.
CATALOG_SEARCH_EXPORT_ENABLED=false
CATALOG_SEARCH_PUBLISH_ENABLED=false
# Publisher uses MESSAGING_URL with the dedicated Catalog broker role.
