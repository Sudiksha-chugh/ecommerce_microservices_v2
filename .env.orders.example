NODE_ENV=development
ORDERS_HOST=127.0.0.1
ORDERS_PORT=4003
ORDERS_PGHOST=127.0.0.1
ORDERS_PGPORT=5432
ORDERS_PGDATABASE=orders_db
ORDERS_PGUSER=orders_user
ORDERS_PGPASSWORD=
ORDERS_TEST_PASSWORD=
ORDERS_PGPOOL_MAX=10
ORDERS_PGCONNECT_TIMEOUT_MS=2000
ORDERS_PGQUERY_TIMEOUT_MS=2000
CART_SERVICE_URL=http://127.0.0.1:4002
CART_REQUEST_TIMEOUT_MS=2000
CATALOG_SERVICE_URL=http://127.0.0.1:4001
CATALOG_REQUEST_TIMEOUT_MS=2000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
SHUTDOWN_TIMEOUT_MS=10000

# Optional Phase 10 bootstrap; use commerce_orders credentials from .env.messaging.
MESSAGING_ENABLED=false
MESSAGING_DIAGNOSTIC_CONSUMERS=false
MESSAGING_URL=
MESSAGING_PREFETCH=5

# Independent Phase 11 worker. MESSAGING_URL must use commerce_orders credentials.
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_CAP_MS=900000
OUTBOX_SHUTDOWN_TIMEOUT_MS=10000

# Read-only notification service lookup. Disabled when empty; use a shared random 32+ character key.
NOTIFICATION_LOOKUP_KEY=
