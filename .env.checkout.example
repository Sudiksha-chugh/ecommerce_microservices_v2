# Optional Phase 12 activation. Copy to .env.checkout and supply secrets locally.
CHECKOUT_SAGA_ENABLED=true
MESSAGING_ENABLED=true
MESSAGING_DIAGNOSTIC_CONSUMERS=false
# Each process uses its own service-specific MESSAGING_URL from .env.orders/.inventory/.payments.
# Do not put a shared broker account here. Configure RabbitMQ permissions with rabbitmq:provision.
# Three distinct random secrets, at least 32 characters each. Never use customer JWTs for commands.
SAGA_ORDERS_KEY=
SAGA_INVENTORY_KEY=
SAGA_PAYMENTS_KEY=

# Phase 13 remains separately opt-in. Set true explicitly after service/provider migration approval.
REFUNDS_ENABLED=false
