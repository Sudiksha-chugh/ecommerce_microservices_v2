# Loaded only by Auth Service; do not put the private key configuration in .env.
NODE_ENV=development
AUTH_HOST=127.0.0.1
AUTH_PORT=4000
AUTH_PGHOST=127.0.0.1
AUTH_PGPORT=5432
AUTH_PGDATABASE=auth_db
AUTH_PGUSER=auth_user
AUTH_PGPASSWORD=
AUTH_TEST_PASSWORD=
AUTH_PGPOOL_MAX=10
AUTH_PGCONNECT_TIMEOUT_MS=2000
AUTH_PGQUERY_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
AUTH_JWT_PRIVATE_KEY_FILE=../../.secrets/auth-private.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Set explicitly when running npm run auth:bootstrap-admin.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
