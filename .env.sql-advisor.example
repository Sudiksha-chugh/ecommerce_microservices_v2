# Start only the existing internal diagnostics process, never a business dependency.
# Also supply the Phase 18 SQL_DIAGNOSTIC_* and JWT_* settings from its runbook.
SQL_ADVISOR_AI_ENABLED=false
# Required only when AI is enabled: offline or openai
SQL_ADVISOR_PROVIDER=offline
# Explicit model required with openai; select a model supporting structured output.
SQL_ADVISOR_MODEL=
# Inject SQL_ADVISOR_API_KEY securely at runtime. Never commit it.
SQL_ADVISOR_TIMEOUT_MS=3000
SQL_ADVISOR_MAX_CONCURRENT=2
SQL_ADVISOR_MAX_OUTPUT_TOKENS=2000
SQL_ADVISOR_REQUESTS_PER_MINUTE=10
SQL_ADVISOR_TOKENS_PER_MINUTE=100000
SQL_ADVISOR_CACHE_TTL_MS=60000
SQL_ADVISOR_CACHE_ENTRIES=32
