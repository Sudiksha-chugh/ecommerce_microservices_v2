NODE_ENV=development
CART_HOST=127.0.0.1
CART_PORT=4002
CART_REDIS_URL=redis://127.0.0.1:6379/0
# Tests require Redis database 15 and also use a random key prefix.
CART_TEST_REDIS_URL=redis://127.0.0.1:6379/15
CART_TTL_SECONDS=604800
CART_REDIS_CONNECT_TIMEOUT_MS=2000
CART_REDIS_COMMAND_TIMEOUT_MS=2000
CATALOG_SERVICE_URL=http://127.0.0.1:4001
CATALOG_REQUEST_TIMEOUT_MS=2000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
SHUTDOWN_TIMEOUT_MS=10000
