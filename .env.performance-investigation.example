# Shared internal diagnostics host. No business endpoint or new service is started.
PERFORMANCE_DIAGNOSTICS_ENABLED=true
INCIDENT_DIAGNOSTIC_PORT=3219
JWT_PUBLIC_KEY_FILE=/operator/config/admin-public.pem
JWT_ISSUER=configure-existing-issuer
JWT_AUDIENCE=configure-existing-audience
# Literal loopback backends only. Operator-managed authenticated local tunnels may be used.
PERFORMANCE_PROMETHEUS_ORIGIN=http://127.0.0.1:9090
PERFORMANCE_TEMPO_ORIGIN=http://127.0.0.1:3200
PERFORMANCE_AI_ENABLED=false
# Optional explicit offline enrichment: PERFORMANCE_AI_ENABLED=true PERFORMANCE_AI_PROVIDER=offline
# Optional live provider: openai, explicit PERFORMANCE_AI_MODEL, PERFORMANCE_AI_API_KEY.
# Do not put keys in source control. No live provider calls are made by tests.
# Process-local SQL telemetry is available only in a hosting process with a valid service identity.
# A dedicated diagnostics process normally reports SQL unavailable; no automatic queries or EXPLAIN.
