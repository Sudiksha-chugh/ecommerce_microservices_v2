NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CATALOG_HOST=127.0.0.1
CATALOG_PORT=4001
CATALOG_SERVICE_URL=http://127.0.0.1:4001
CATALOG_REQUEST_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=catalog_db
PGUSER=catalog_user
# Supply your own local passwords; neither value has a default.
PGPASSWORD=
CATALOG_TEST_PASSWORD=
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=2000
PGQUERY_TIMEOUT_MS=2000

AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_REQUEST_TIMEOUT_MS=3000
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
# Paths are relative to service workspace working directories.
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem

CART_SERVICE_URL=http://127.0.0.1:4002
CART_REQUEST_TIMEOUT_MS=3000
CART_REDIS_PORT=6379

ORDERS_SERVICE_URL=http://127.0.0.1:4003
ORDERS_REQUEST_TIMEOUT_MS=10000

INVENTORY_SERVICE_URL=http://127.0.0.1:4005
INVENTORY_REQUEST_TIMEOUT_MS=10000

PAYMENTS_SERVICE_URL=http://127.0.0.1:4004
PAYMENTS_REQUEST_TIMEOUT_MS=10000

# Phase 15: explicitly opt in after configuring the shared JWT verifier.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380/0
RATE_LIMIT_KEY_PREFIX=ecommerce:v2:ratelimit:v1
RATE_LIMIT_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_COMMAND_TIMEOUT_MS=200
RATE_LIMIT_MAX_PENDING=100
RATE_LIMIT_FAIL_OPEN_PUBLIC=true
# Comma-separated explicit addresses/CIDRs; empty means direct clients only.
RATE_LIMIT_TRUSTED_PROXIES=
# Strict JSON: policy name -> capacity, refillTokens, windowMs. Burst capacity is independent of refill.
RATE_LIMIT_POLICY_OVERRIDES={}

# Phase 16 public search routing remains opt-in. Search performs bounded ES + Catalog RPCs.
SEARCH_ENABLED=false
SEARCH_SERVICE_URL=http://127.0.0.1:4008
SEARCH_GATEWAY_TIMEOUT_MS=5000
CATALOG_SEARCH_EXPORT_ENABLED=false
CATALOG_SEARCH_PUBLISH_ENABLED=false
