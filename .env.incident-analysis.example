# Opt in only on the authenticated loopback diagnostics process. No business app mounts these routes.
INCIDENT_DIAGNOSTICS_ENABLED=false
INCIDENT_DIAGNOSTIC_PORT=3219
# Explicit literal loopback origins. Remote deployments require authenticated local tunnels.
INCIDENT_PROMETHEUS_ORIGIN=http://127.0.0.1:9090
INCIDENT_TEMPO_ORIGIN=http://127.0.0.1:3200
# Reuse existing JWT public key / issuer / audience configuration.
# JWT_PUBLIC_KEY_FILE=/absolute/path/to/public-key.pem
# JWT_ISSUER=...
# JWT_AUDIENCE=...
INCIDENT_AI_ENABLED=false
# Explicitly choose offline or openai when enabling AI. Never enable live AI in CI.
# INCIDENT_AI_PROVIDER=offline
# INCIDENT_AI_MODEL=explicit-model
# INCIDENT_AI_API_KEY=operator-provided-value
INCIDENT_AI_TIMEOUT_MS=3000
INCIDENT_AI_MAX_OUTPUT_TOKENS=2000
INCIDENT_AI_TOKENS_PER_MINUTE=100000
INCIDENT_AI_REQUESTS_PER_MINUTE=10
INCIDENT_AI_MAX_CONCURRENT=2
INCIDENT_LIMIT_DURATION_MS=10000
INCIDENT_LIMIT_WINDOW_MS=3600000
INCIDENT_LIMIT_SERVICES=9
INCIDENT_LIMIT_METRIC_SAMPLES=5000
INCIDENT_LIMIT_TRACE_SPANS=500
INCIDENT_LIMIT_LOG_RECORDS=100
INCIDENT_LIMIT_EVIDENCE_RECORDS=128
INCIDENT_LIMIT_EVIDENCE_BYTES=131072
INCIDENT_LIMIT_RESPONSE_BYTES=1048576
INCIDENT_LIMIT_BACKEND_TIMEOUT_MS=1500
INCIDENT_LIMIT_CONCURRENT=2
INCIDENT_LIMIT_CACHE_ENTRIES=32
INCIDENT_LIMIT_CACHE_TTL_MS=15000
INCIDENT_LIMIT_STALE_MS=300000
INCIDENT_LIMIT_SKEW_MS=5000
INCIDENT_LIMIT_REQUESTS_PER_MINUTE=20
