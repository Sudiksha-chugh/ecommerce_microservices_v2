NODE_ENV=development
PAYMENTS_HOST=127.0.0.1
PAYMENTS_PORT=4004
PAYMENTS_PGHOST=127.0.0.1
PAYMENTS_PGPORT=5432
PAYMENTS_PGDATABASE=payments_db
PAYMENTS_PGUSER=payments_user
PAYMENTS_PGPASSWORD=
PAYMENTS_TEST_PASSWORD=
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_PUBLIC_KEY_FILE=../../.secrets/auth-public.pem
MOCK_PROVIDER_URL=http://127.0.0.1:4006
PROVIDER_REQUEST_TIMEOUT_MS=2000
PAYMENT_LEASE_MS=10000
RECONCILIATION_INTERVAL_MS=5000
RECONCILIATION_BATCH_SIZE=10

# Optional Phase 10 bootstrap; use commerce_payments credentials from .env.messaging.
MESSAGING_ENABLED=false
MESSAGING_DIAGNOSTIC_CONSUMERS=false
MESSAGING_URL=
MESSAGING_PREFETCH=5

# Phase 11: opt-in transactional receipts only, no checkout effects.
INBOX_ENABLED=false
