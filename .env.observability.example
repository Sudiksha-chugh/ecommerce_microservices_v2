# Explicit opt-in. Host services export to the Collector's loopback OTLP endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_CONTAINER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_LOG_LEVEL=error
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_EXPORTER_OTLP_TIMEOUT=1000
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_SHUTDOWN_TIMEOUT_MS=1000
# Point at your own local password file; never commit the file.
OBS_GRAFANA_PASSWORD_FILE=./.secrets/observability-grafana-password

# SQL telemetry also requires OTEL_ENABLED=true. No raw SQL is retained.
OTEL_SQL_ENABLED=false
OTEL_SQL_SAMPLE_RATIO=0.1
OTEL_SQL_MAX_FINGERPRINTS=32
OTEL_SQL_RETENTION_MS=300000
OTEL_SQL_SLOW_MS=250
# Separate internal diagnostic process; credential files are never committed.
SQL_DIAGNOSTICS_ENABLED=false
SQL_DIAGNOSTIC_SERVICE=catalog
SQL_DIAGNOSTIC_PORT=3218
SQL_DIAGNOSTIC_PGHOST=127.0.0.1
SQL_DIAGNOSTIC_PGPORT=5432
SQL_DIAGNOSTIC_PGDATABASE=catalog_diagnostic_replica
SQL_DIAGNOSTIC_PGUSER=sql_diag_catalog
SQL_DIAGNOSTIC_PASSWORD_FILE=./.secrets/sql-diagnostic-password
