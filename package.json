{
  "name": "ecommerce-microservices-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@ecommerce/api-gateway",
    "start": "npm run start --workspace=@ecommerce/api-gateway",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:gateway": "npm run dev --workspace=@ecommerce/api-gateway",
    "dev:catalog": "npm run dev --workspace=@ecommerce/catalog-service",
    "start:gateway": "npm run start --workspace=@ecommerce/api-gateway",
    "start:catalog": "npm run start --workspace=@ecommerce/catalog-service",
    "db:up": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging up -d --build --wait",
    "db:migrate": "npm run migrate --workspace=@ecommerce/catalog-service",
    "db:seed": "npm run seed --workspace=@ecommerce/catalog-service",
    "dev:auth": "npm run dev --workspace=@ecommerce/auth-service",
    "start:auth": "npm run start --workspace=@ecommerce/auth-service",
    "auth:migrate": "npm run migrate --workspace=@ecommerce/auth-service",
    "auth:bootstrap-admin": "npm run bootstrap-admin --workspace=@ecommerce/auth-service",
    "db:provision-auth": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "dev:cart": "npm run dev --workspace=@ecommerce/cart-service",
    "start:cart": "npm run start --workspace=@ecommerce/cart-service",
    "redis:up": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging up -d --wait redis",
    "dev:orders": "npm run dev --workspace=@ecommerce/orders-service",
    "start:orders": "npm run start --workspace=@ecommerce/orders-service",
    "orders:migrate": "npm run migrate --workspace=@ecommerce/orders-service",
    "db:provision-orders": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "dev:inventory": "npm run dev --workspace=@ecommerce/inventory-service",
    "start:inventory": "npm run start --workspace=@ecommerce/inventory-service",
    "inventory:migrate": "npm run migrate --workspace=@ecommerce/inventory-service",
    "db:provision-inventory": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "dev:payments": "npm run dev --workspace=@ecommerce/payments-service",
    "start:payments": "npm run start --workspace=@ecommerce/payments-service",
    "payments:migrate": "npm run migrate --workspace=@ecommerce/payments-service",
    "start:mock-provider": "npm run mock-provider --workspace=@ecommerce/payments-service",
    "mock-provider:migrate": "npm run mock:migrate --workspace=@ecommerce/payments-service",
    "db:provision-payments": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "rabbitmq:up": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory --env-file .env.payments --env-file .env.mock-provider --env-file .env.messaging up -d --wait rabbitmq",
    "rabbitmq:provision": "python3 infrastructure/rabbitmq/provision.py",
    "messaging:demo": "tsx --env-file-if-exists=.env.messaging packages/messaging/src/demo.ts",
    "test:messaging": "vitest run packages/messaging/test",
    "messaging:replay": "tsx packages/messaging/src/replay.ts",
    "orders:outbox": "npm run outbox --workspace=@ecommerce/orders-service",
    "orders:outbox:requeue": "npm run outbox:requeue --workspace=@ecommerce/orders-service",
    "test:event-persistence": "vitest run packages/event-persistence/test",
    "test:checkout": "vitest run apps/orders-service/test/checkout.test.ts --maxWorkers=1",
    "dev:checkout:orders": "tsx --env-file=.env.orders --env-file=.env.checkout --import ./packages/observability/bootstrap.mjs apps/orders-service/src/server.ts",
    "dev:checkout:inventory": "tsx --env-file=.env.inventory --env-file=.env.checkout --import ./packages/observability/bootstrap.mjs apps/inventory-service/src/server.ts",
    "dev:checkout:payments": "tsx --env-file=.env.payments --env-file=.env.checkout --import ./packages/observability/bootstrap.mjs apps/payments-service/src/server.ts",
    "test:refunds": "vitest run apps/orders-service/test/refund-compensation.test.ts --maxWorkers=1",
    "test:cancellation": "vitest run apps/orders-service/test/refund-compensation.test.ts --maxWorkers=1",
    "dev:notifications": "npm run dev --workspace=@ecommerce/notification-service",
    "start:notifications": "npm run start --workspace=@ecommerce/notification-service",
    "notifications:migrate": "npm run migrate --workspace=@ecommerce/notification-service",
    "notifications:mock:migrate": "npm run mock:migrate --workspace=@ecommerce/notification-service",
    "test:notifications": "vitest run apps/notification-service/test --maxWorkers=1",
    "notifications:test:up": "docker compose -p commerce-v2-phase14-test -f compose.notifications-test.yaml up -d --wait",
    "notifications:test:down": "docker compose -p commerce-v2-phase14-test -f compose.notifications-test.yaml down",
    "test:isolated": "node scripts/integration-runner.mjs",
    "notifications:smoke": "node --import tsx scripts/notification-compose-smoke.mjs",
    "test:rate-limiting": "vitest run packages/rate-limiting/test",
    "dev:search": "npm run dev --workspace=@ecommerce/search-service",
    "start:search": "npm run start --workspace=@ecommerce/search-service",
    "search:migrate": "npm run migrate --workspace=@ecommerce/search-service",
    "test:search": "vitest run apps/search-service/test",
    "search:smoke": "node --import tsx scripts/search-compose-smoke.mjs",
    "search:restart-check": "node --import tsx scripts/search-restart-check.mjs",
    "test:harness": "vitest run --config vitest.harness.config.mjs",
    "verify:phase16": "node scripts/verify-phase16.mjs",
    "test:observability": "vitest run packages/observability/test",
    "verify:observability": "node scripts/observability-runner.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
