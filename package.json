{
  "name": "ecommerce-microservices-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@ecommerce/api-gateway",
    "start": "npm run start --workspace=@ecommerce/api-gateway",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:gateway": "npm run dev --workspace=@ecommerce/api-gateway",
    "dev:catalog": "npm run dev --workspace=@ecommerce/catalog-service",
    "start:gateway": "npm run start --workspace=@ecommerce/api-gateway",
    "start:catalog": "npm run start --workspace=@ecommerce/catalog-service",
    "db:up": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory up -d --build --wait",
    "db:migrate": "npm run migrate --workspace=@ecommerce/catalog-service",
    "db:seed": "npm run seed --workspace=@ecommerce/catalog-service",
    "dev:auth": "npm run dev --workspace=@ecommerce/auth-service",
    "start:auth": "npm run start --workspace=@ecommerce/auth-service",
    "auth:migrate": "npm run migrate --workspace=@ecommerce/auth-service",
    "auth:bootstrap-admin": "npm run bootstrap-admin --workspace=@ecommerce/auth-service",
    "db:provision-auth": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "dev:cart": "npm run dev --workspace=@ecommerce/cart-service",
    "start:cart": "npm run start --workspace=@ecommerce/cart-service",
    "redis:up": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory up -d --wait redis",
    "dev:orders": "npm run dev --workspace=@ecommerce/orders-service",
    "start:orders": "npm run start --workspace=@ecommerce/orders-service",
    "orders:migrate": "npm run migrate --workspace=@ecommerce/orders-service",
    "db:provision-orders": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh",
    "dev:inventory": "npm run dev --workspace=@ecommerce/inventory-service",
    "start:inventory": "npm run start --workspace=@ecommerce/inventory-service",
    "inventory:migrate": "npm run migrate --workspace=@ecommerce/inventory-service",
    "db:provision-inventory": "docker compose --env-file .env --env-file .env.auth --env-file .env.orders --env-file .env.inventory exec -T postgres bash /docker-entrypoint-initdb.d/init-test-db.sh"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
